<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ ignores allowBackup="false" for device-to-device transfer, so without
  these rules setting up a new phone would copy vault.bin, its snapshots and the
  preferences across. They couldn't be decrypted there (the keystore key never
  leaves the device), but "nothing leaves the device" should hold literally.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
